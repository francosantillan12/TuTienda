<div id="catalogo" data-carrito="{{#if usuario}}{{usuario.carritoId}}{{/if}}">

    <h1>📦 Catálogo</h1>

    <div class="buscador-productos">

        <input type="text" id="buscador-productos" placeholder="🔍 Buscar producto...">

        <select id="filtro-categoria">

            <option value="">Todas las categorías</option>

            {{#each categorias}}

            <option value="{{this}}">
                {{this}}
            </option>

            {{/each}}

        </select>

        <select id="ordenar-productos">

            <option value="">Ordenar por...</option>

            <option value="stock-desc">
                Stock (Mayor a menor)
            </option>

            <option value="stock-asc">
                Stock (Menor a mayor)
            </option>

            <option value="vencimiento-asc">
                Vencimiento (Más próximo)
            </option>

            <option value="vencimiento-desc">
                Vencimiento (Más lejano)
            </option>

        </select>

    </div>

    <div class="catalogo-container">

        <table class="tabla-productos">

            <thead>

                <tr>

                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Vencimiento</th>
                    <th></th>

                </tr>

            </thead>

            <tbody>

                {{#each productos}}

                <tr class="producto-fila"  
                    data-id="{{_id}}" 
                    data-titulo="{{titulo}}" 
                    data-categoria="{{categoria}}"
                    data-codigo="{{codigo}}" 
                    data-stock="{{stock}}"
                    data-precio="{{precio}}"
                    data-fecha-vencimiento="{{fechaVencimiento}}"
                    >
                    

                    <td class="producto-nombre">

                        {{titulo}}

                    </td>

                    <td>

                        {{categoria}}

                    </td>

                    <td class="producto-precio">

                        ${{precio}}

                    </td>

                    <td>

                        {{stock}}

                    </td>

                   <td class="producto-vencimiento">
                        {{#if fechaVencimiento}}
                            {{formatearFecha fechaVencimiento}}
                        {{else}}
                            -
                        {{/if}}
                    </td>

                    <td>

                        <button class="boton-agregar">

                            <i class="bi bi-cart-plus-fill"></i>

                            Caja

                        </button>

                    </td>

                </tr>

                {{/each}}

            </tbody>

        </table>

    </div>

</div>

<script defer src="/public/js/catalogo.js"></script>