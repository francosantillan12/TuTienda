<link rel="stylesheet" href="/public/css/ventas.css">

<h1>💰 Ventas</h1>

<div class="ventas-dashboard">

    <!-- VENTAS REALIZADAS HOY -->
    <div class="venta-card">

        <h3>🛒 Ventas realizadas hoy</h3>

        <h2 id="ventas-realizadas">
            {{ventasHoy}}
        </h2>

    </div>


    <!-- TOTAL VENDIDO HOY -->
    <div class="venta-card">

        <h3>💵 Total vendido hoy</h3>

        <h2 id="total-vendido">
            {{formatearDinero totalVendidoHoy}}
        </h2>

    </div>


    <!-- TICKET PROMEDIO HOY -->
    <div class="venta-card">

        <h3>📈 Ticket promedio hoy</h3>

        <h2 id="ticket-promedio">
            {{formatearDinero ticketPromedioHoy}}
        </h2>

    </div>


    <!-- MÁS VENDIDO HOY -->
    <div class="venta-card">

        <h3>🏆 Más vendido hoy</h3>

        {{#if productoMasVendidoHoy}}

        <h2 id="producto-mas-vendido-hoy">
            {{productoMasVendidoHoy}}
        </h2>

        <p class="cantidad-vendida">
            🥤
            <span id="cantidad-mas-vendido-hoy">
                {{cantidadProductoMasVendidoHoy}}
            </span>
            unidades
        </p>

        {{else}}

        <h2 id="producto-mas-vendido-hoy">
            Ninguna venta realizada
        </h2>

        <p class="cantidad-vendida">
            🥤
            <span id="cantidad-mas-vendido-hoy">
                0
            </span>
            unidades
        </p>

        {{/if}}

    </div>


    <!-- MÁS VENDIDO HISTÓRICO -->
    <div class="venta-card">

        <h3>👑 Más vendido histórico</h3>

        {{#if productoMasVendido}}

        <h2 id="producto-mas-vendido">
            {{productoMasVendido}}
        </h2>

        <p class="cantidad-vendida">
            🥤
            <span id="cantidad-mas-vendido">
                {{cantidadProductoMasVendido}}
            </span>
            unidades
        </p>

        {{else}}

        <h2 id="producto-mas-vendido">
            Calculando...
        </h2>

        <p class="cantidad-vendida">
            🥤
            <span id="cantidad-mas-vendido">
                0
            </span>
            unidades
        </p>

        {{/if}}

    </div>



    <!-- VENTAS POR PERÍODO -->
   <div class="venta-card">

    <h3>📊 Ventas por período</h3>

    <div class="filtro-ventas">

        <div class="fechas-periodo">

            <label>
                Desde
                <input type="date" id="fecha-desde">
            </label>

            <span class="separador-fechas">→</span>

            <label>
                Hasta
                <input type="date" id="fecha-hasta">
            </label>

        </div>

        <button type="button" id="btn-consultar-ventas">
            🔎 Consultar
        </button>

    </div>

    <h2 id="total-vendido-periodo">
    $0
    </h2>

    <p id="cantidad-ventas-periodo">
        Seleccioná un período
    </p>

</div>
</div>

<!-- HISTORIAL DE VENTAS -->

<h2>📋 Historial de ventas</h2>

<div class="historial-container">

    <table class="tabla-ventas">

        <thead>

            <tr>

                <th>Fecha</th>

                <th>Ticket</th>

                <th>Cliente</th>

                <th>Total</th>

                <th>Acción</th>

            </tr>

        </thead>


        <tbody>

            {{#each tickets}}

            <tr>

                <td>
                    {{formatearFecha purchase_datetime}}
                </td>

                <td>
                    {{formatearCodigoTicket code}}
                </td>

                <td>
                    {{purchaser}}
                </td>

                <td>
                    {{formatearDinero amount}}
                </td>

                <td class="acciones-ticket">

                    <a href="/ticket/{{_id}}" class="btn-ver-ticket">
                        👁 Ver
                    </a>

                    <button class="btn-eliminar-ticket" data-id="{{_id}}">
                        🗑
                    </button>

                </td>

            </tr>

            {{/each}}

        </tbody>

    </table>

</div>


<script defer src="/public/js/ventas.js"></script>