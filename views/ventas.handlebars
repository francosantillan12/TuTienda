<link rel="stylesheet" href="/public/css/ventas.css">

<h1>💰 Ventas</h1>

<div class="ventas-dashboard">

    <div class="venta-card">

        <h3>🛒 Ventas realizadas</h3>

        <h2>{{tickets.length}}</h2>

    </div>

    <div class="venta-card">

        <h3>💵 Total vendido</h3>

        <h2>{{formatearDinero totalVendido}}</h2>

    </div>

    <div class="venta-card">

        <h3>📈 Ticket promedio</h3>

        <h2>{{formatearDinero ticketPromedio}}</h2>

    </div>

    <div class="venta-card">

        <h3>🏆 Más vendido hoy</h3>

        {{#if productoMasVendidoHoy}}

        <h2>{{productoMasVendidoHoy}}</h2>

        <p class="cantidad-vendida">

            🥤 {{cantidadProductoMasVendidoHoy}} unidades

        </p>

        {{else}}

        <h2>Ninguna venta realizada</h2>

        {{/if}}

    </div>

    <div class="venta-card">

        <h3>👑 Más vendido histórico</h3>

        {{#if productoMasVendido}}

        <h2>{{productoMasVendido}}</h2>

        <p class="cantidad-vendida">

            🥤 {{cantidadProductoMasVendido}} unidades

        </p>

        {{else}}

        <h2>Calculando...</h2>

        {{/if}}

    </div>

    <div class="venta-card">

        <h3>💵 Apertura de caja</h3>

        <h2>Próximamente</h2>

    </div>

</div>

<h2>📋 Historial de ventas</h2>

<div class="historial-container">

    <table class="tabla-ventas">

        <thead>

            <tr>

                <th>Fecha</th>
                <th>Ticket</th>
                <th>Cliente</th>
                <th>Total</th>
                <th>Acción</th>

            </tr>

        </thead>

        <tbody>

            {{#each tickets}}

            <tr>

                <td>{{formatearFecha purchase_datetime}}</td>

                <td>{{formatearCodigoTicket code}}</td>

                <td>{{purchaser}}</td>

                <td>{{formatearDinero amount}}</td>

                <td class="acciones-ticket">

                    <a href="/ticket/{{_id}}" class="btn-ver-ticket">

                        👁 Ver

                    </a>

                    <button class="btn-eliminar-ticket" data-id="{{_id}}">

                        🗑

                    </button>

                </td>

            </tr>

            {{/each}}

        </tbody>

    </table>
</div>

<script defer src="/public/js/ventas.js"></script>