<div id="caja" data-carrito="{{carrito._id}}">

    <h1>💵 Caja</h1>

    <div class="caja-total">

        <span>Total a cobrar</span>

        <h2>$ {{total}}</h2>

    </div>


    <div class="acciones-caja">

        <button id="btn-vaciar" class="btn-vaciar">
            🗑 Cancelar venta
        </button>

        <button id="btn-comprar" class="btn-comprar">
            💳 Cobrar
        </button>

    </div>


    <table class="tabla-caja">

        <thead>

            <tr>

                <th>Producto</th>
                <th>Cantidad</th>
                <th>Precio Unit.</th>
                <th>Subtotal</th>
                <th></th>

            </tr>

        </thead>


        <tbody>

            {{#each carrito.products}}

                {{#if this.product}}

                    <tr>

                        <td>
                            {{this.product.titulo}}
                        </td>

                        <td>

                            <button
                                class="btn-restar"
                                data-pid="{{this.product._id}}"
                                data-quantity="{{this.quantity}}"
                            >
                                ➖
                            </button>

                            <span class="cantidad-producto">
                                {{this.quantity}}
                            </span>

                            <button
                                class="btn-sumar"
                                data-pid="{{this.product._id}}"
                                data-quantity="{{this.quantity}}"
                            >
                                ➕
                            </button>

                        </td>

                        <td>
                            ${{this.product.precio}}
                        </td>

                        <td>
                            ${{multiplicar this.product.precio this.quantity}}
                        </td>

                        <td>

                            <button
                                class="btn-eliminar"
                                data-pid="{{this.product._id}}"
                            >
                                ❌
                            </button>

                        </td>

                    </tr>

                {{/if}}

            {{/each}}


            {{#each carrito.manualItems}}

                <tr>

                    <td>
                        {{this.title}}
                    </td>

                    <td>
                        1
                    </td>

                    <td>
                        ${{this.price}}
                    </td>

                    <td>
                        ${{this.price}}
                    </td>

                    <td>

                        <button
                            class="btn-eliminar-manual"
                            data-id="{{this._id}}"
                        >
                            ❌
                        </button>

                    </td>

                </tr>

            {{/each}}

        </tbody>

    </table>


    <div class="importe-manual">

        <h3>➕ Agregar importe manual</h3>

        <div class="importe-manual-form">

            <input
                type="text"
                id="descripcion-manual"
                placeholder="Descripción (ej: Jamón cocido)"
            >

            <input
                type="number"
                id="importe-manual"
                placeholder="Importe"
                min="0"
                step="1"
            >

            <button
                type="button"
                id="btn-agregar-manual"
                class="btn-agregar-manual"
            >
                ➕ Agregar
            </button>

        </div>

    </div>

</div>


<script defer src="/public/js/caja.js"></script>